{
    "manifest_version": 3,
    "name": "JobTracker",
    "version": "1.0.0",
    "description": "Add job applications to JobTracker with one click",
    "permissions": [
        "activeTab",
        "storage",
        "cookies",
        "tabs"
    ],
    "host_permissions": [
        "https://www.linkedin.com/*",
        "https://www.indeed.com/*",
        "https://*.indeed.com/*",
        "https://jobtracker-three-delta.vercel.app/*",
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "32": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "exclude_matches": [
                "https://jobtracker-three-delta.vercel.app/*"
            ]
        },
        {
            "matches": [
                "https://jobtracker-three-delta.vercel.app/*"
            ],
            "js": [
                "auth-bridge.js"
            ]
        }
    ]
    
}